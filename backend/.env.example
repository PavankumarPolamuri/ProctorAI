# Backend Environment Variables Example
# Set these environment variables in your hosting provider (e.g. Render, Railway, Heroku) or local environment.

# Server Port
PORT=8080

# Allowed Frontend URL for CORS (e.g., https://your-proctorai.vercel.app)
FRONTEND_URL=https://your-proctorai.vercel.app

# JWT Secret Key (min 32 characters for HMAC-SHA256)
JWT_SECRET=your_super_secret_jwt_key_must_be_long_enough_here_123456

# JWT Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# Optional Initial Admin Seed Overrides
ADMIN_EMAIL=your_admin_email_here
ADMIN_PASSWORD=your_secure_admin_password_here

# Database Configuration (Defaults to in-memory H2 if not provided)
# For MySQL / PostgreSQL in production:
DATABASE_URL=jdbc:mysql://your-db-host:3306/proctoraidb
DATABASE_USERNAME=your_db_username
DATABASE_PASSWORD=your_db_password
DATABASE_DRIVER=com.mysql.cj.jdbc.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
