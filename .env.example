# ProctorAI - Project Environment Variables Guide

# ==========================================
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel)
# ==========================================
# VITE_API_URL=https://your-proctorai-backend.onrender.com/api
# VITE_WS_URL=https://your-proctorai-backend.onrender.com/ws

# ==========================================
# 2. BACKEND ENVIRONMENT VARIABLES (Render)
# ==========================================
# PORT=8080
# FRONTEND_URL=https://your-proctorai.vercel.app
# JWT_SECRET=your_super_secret_jwt_key_must_be_long_enough_here_123456
# JWT_EXPIRATION=86400000
# DATABASE_URL=jdbc:mysql://your-db-host:3306/proctoraidb
# DATABASE_USERNAME=your_db_username
# DATABASE_PASSWORD=your_db_password
