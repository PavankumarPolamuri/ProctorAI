# Frontend Environment Variables Example
# Copy this file to .env or .env.local and set your actual configuration values.

# Backend API Base URL (e.g., https://your-proctorai-backend.onrender.com/api or http://localhost:8080/api)
VITE_API_URL=https://your-proctorai-backend.onrender.com/api

# Backend WebSocket URL (e.g., https://your-proctorai-backend.onrender.com/ws or http://localhost:8080/ws)
VITE_WS_URL=https://your-proctorai-backend.onrender.com/ws
